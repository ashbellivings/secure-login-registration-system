# ==============================================================
# SECURE USER AUTHENTICATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================

# Application Runtime (set to "production" on Render)
NODE_ENV=development

# Server Port (Render dynamically assigns PORT at runtime; default fallback: 3000)
PORT=3000

# Production MongoDB Connection String (Required in production)
# Example MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net/secure_auth_db?retryWrites=true&w=majority
MONGODB_URI=

# Session Cryptographic Signing Key (Required in production: minimum 32 characters)
# Generate a cryptographically secure random secret, e.g. via `openssl rand -hex 32`
SESSION_SECRET=your_secure_random_session_secret_at_least_32_characters_long

# Cryptographic Password Work Factor (Default: 12)
BCRYPT_SALT_ROUNDS=12

